+static GstBuffer *
+gst_flv_demux_hevc_nalu_to_byte_stream (GstFlvDemux * demux,
+    GstBuffer * buffer, guint offset, guint size)
+{
+  GstBuffer *outbuf;
+  GstMapInfo in_map, out_map;
+  guint in_pos = 0, out_pos = 0;
+  const guint8 *in_data;
+  guint8 *out_data;
+
+  if (G_UNLIKELY (size < 4))
+    return NULL;
+
+  if (!gst_buffer_map (buffer, &in_map, GST_MAP_READ))
+    return NULL;
+
+  in_data = in_map.data + offset;
+
+  if ((size >= 4 && in_data[0] == 0x00 && in_data[1] == 0x00 &&
+          in_data[2] == 0x00 && in_data[3] == 0x01) ||
+      (size >= 3 && in_data[0] == 0x00 && in_data[1] == 0x00 &&
+          in_data[2] == 0x01)) {
+    gst_buffer_unmap (buffer, &in_map);
+    GST_DEBUG_OBJECT (demux, "H.265 fallback payload is already byte-stream");
+    return gst_buffer_copy_region (buffer, GST_BUFFER_COPY_MEMORY, offset,
+        size);
+  }
+
+  outbuf = gst_buffer_new_allocate (NULL, size, NULL);
+  if (G_UNLIKELY (!outbuf)) {
+    gst_buffer_unmap (buffer, &in_map);
+    return NULL;
+  }
+
+  if (!gst_buffer_map (outbuf, &out_map, GST_MAP_WRITE)) {
+    gst_buffer_unref (outbuf);
+    gst_buffer_unmap (buffer, &in_map);
+    return NULL;
+  }
+
+  out_data = out_map.data;
+
+  while (in_pos < size) {
+    guint32 nal_size;
+
+    if (G_UNLIKELY (size - in_pos < 4))
+      goto invalid_length_prefixed_data;
+
+    nal_size = GST_READ_UINT32_BE (in_data + in_pos);
+    in_pos += 4;
+
+    if (G_UNLIKELY (nal_size == 0 || nal_size > size - in_pos))
+      goto invalid_length_prefixed_data;
+
+    out_data[out_pos++] = 0x00;
+    out_data[out_pos++] = 0x00;
+    out_data[out_pos++] = 0x00;
+    out_data[out_pos++] = 0x01;
+    memcpy (out_data + out_pos, in_data + in_pos, nal_size);
+    in_pos += nal_size;
+    out_pos += nal_size;
+  }
+
+  gst_buffer_unmap (outbuf, &out_map);
+  gst_buffer_unmap (buffer, &in_map);
+
+  if (out_pos != size)
+    gst_buffer_resize (outbuf, 0, out_pos);
+
+  return outbuf;
+
+invalid_length_prefixed_data:
+  GST_WARNING_OBJECT (demux,
+      "invalid H.265 length-prefixed fallback payload at offset %u of %u",
+      in_pos, size);
+  gst_buffer_unmap (outbuf, &out_map);
+  gst_buffer_unref (outbuf);
+  gst_buffer_unmap (buffer, &in_map);
+  return NULL;
+}
